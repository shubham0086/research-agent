# -----------------------------------------------------------------------
# Research Agent — environment variables
# Copy this file to .env and fill in whichever keys you have.
# Everything is optional. With no keys: DuckDuckGo search + raw results.
# -----------------------------------------------------------------------

# LLM providers — set at least one for synthesized reports
# Priority: Anthropic > OpenAI > Groq > Gemini
ANTHROPIC_API_KEY=      # https://console.anthropic.com — best synthesis quality
OPENAI_API_KEY=         # https://platform.openai.com
GROQ_API_KEY=           # https://console.groq.com — FREE tier, very fast
GEMINI_API_KEY=         # https://aistudio.google.com — FREE tier

# Optional: force a specific provider (Anthropic / OpenAI / Groq / Gemini)
PREFERRED_LLM=

# Optional: override default models
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-1.5-flash

# Search providers — configure one or more for best results
# Leave all blank to use DuckDuckGo (free, no key needed)
SERP_API_KEY=           # https://serpapi.com — Google results
TAVILY_API_KEY=         # https://tavily.com — AI-curated search
BRAVE_SEARCH_API_KEY=   # https://brave.com/search/api/

# Research settings
MAX_RESULTS=8
MAX_LLM_TOKENS=3000
