# -----------------------------------------------------------------------
# Research Agent — environment variables
# Set whichever keys you have. Everything is optional.
# With no keys: Ollama local mode. With any key: full synthesized reports.
#
# FREE providers (set these first):
#   GROQ_API_KEY      — console.groq.com (free, very fast)
#   GEMINI_API_KEY    — aistudio.google.com (free tier)
#   OPENROUTER_API_KEY— openrouter.ai (has :free model suffix)
#   MINIMAX_API_KEY   — platform.minimax.io (via OpenCode Zen)
#   Ollama            — run locally, no key needed
#
# PAID providers (better quality):
#   ANTHROPIC_API_KEY — console.anthropic.com (best synthesis)
#   OPENAI_API_KEY    — platform.openai.com
#   DEEPSEEK_API_KEY  — platform.deepseek.com (cheap and capable)
#   SILICONFLOW_API_KEY — siliconflow.cn
#   NIM_API_KEY       — build.nvidia.com
# -----------------------------------------------------------------------

# ---- LLM providers ----

# Free tier
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Paid
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
NIM_API_KEY=

# Local (run: ollama pull qwen2.5-coder:7b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional: force a specific provider instead of auto-cascade
PREFERRED_LLM=

# Optional: override default models
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=qwen/qwen3-coder:free
DEEPSEEK_MODEL=deepseek-chat

# ---- Search providers ----
# Leave blank to use DuckDuckGo (free, no key needed)
SERP_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- Research settings ----
MAX_RESULTS=8
MAX_LLM_TOKENS=3000
