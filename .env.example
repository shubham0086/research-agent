# -----------------------------------------------------------------------
# Research Agent — environment variables
# Copy this file to .env and fill in the values you have.
# Everything is optional: with no keys set the agent runs in fallback mode
# (DuckDuckGo search, no AI analysis).
# -----------------------------------------------------------------------

# OpenAI — enables AI analysis and the full LangChain agent loop
OPENAI_API_KEY=

# LLM settings (optional, defaults shown)
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
MAX_TOKENS=2000

# Search providers — configure one or more for paid search
# Leave all blank to use the free DuckDuckGo fallback
SERP_API_KEY=        # https://serpapi.com
TAVILY_API_KEY=      # https://tavily.com
BRAVE_SEARCH_API_KEY=  # https://brave.com/search/api/
